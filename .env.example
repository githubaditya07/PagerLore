# PagerLore Environment Configuration Template
# Copy this file to .env.local to configure live Hindsight connectivity.
# If these variables are not provided, PagerLore operates in transparent Local DEMO MODE.

# Hindsight Cloud API (Vectorize persistent memory engine)
# HINDSIGHT_API_KEY=your_hindsight_api_key_here
# HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
# HINDSIGHT_BANK_ID=pagerlore-production-bank

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
